{
  "name": "selected-lines-counter",
  "displayName": "Selected Lines Counter",
  "description": "Shows the number of selected lines in the VS Code status bar.",
  "version": "1.0.0",
  "publisher": "YOUR-PUBLISHER-ID",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
